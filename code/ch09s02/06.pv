\BK{c+cm}{/* TICK\BKZus{}USEC\BKZus{}TO\BKZus{}NSEC is the time between ticks in nsec assuming real ACTHZ and  */}
\BK{c+cm}{/* a value TUSEC for TICK\BKZus{}USEC (can be set bij adjtimex)                */}
\BK{c+cp}{\BKZsh{}}\BK{c+cp}{define TICK\BKZus{}USEC\BKZus{}TO\BKZus{}NSEC(TUSEC) (SH\BKZus{}DIV (TUSEC * USER\BKZus{}HZ * 1000, ACTHZ, 8))}

\BK{c+cm}{/* some arch\BKZsq{}s have a small\BKZhy{}data section that can be accessed register\BKZhy{}relative}
\BK{c+cm}{ * but that can only take up to, say, 4\BKZhy{}byte variables. jiffies being part of}
\BK{c+cm}{ * an 8\BKZhy{}byte variable may not be correctly accessed unless we force the issue}
\BK{c+cm}{ */}
\BK{c+cp}{\BKZsh{}}\BK{c+cp}{define \BKZus{}\BKZus{}jiffy\BKZus{}data  \BKZus{}\BKZus{}attribute\BKZus{}\BKZus{}((section(\BKZdq{}.data\BKZdq{})))}

\BK{c+cm}{/*}
\BK{c+cm}{ * The 64\BKZhy{}bit value is not volatile \BKZhy{} you MUST NOT read it}
\BK{c+cm}{ * without sampling the sequence number in xtime\BKZus{}lock.}
\BK{c+cm}{ * get\BKZus{}jiffies\BKZus{}64() will do this for you as appropriate.}
\BK{c+cm}{ */}
\BK{k}{extern}\BK{+w}{ }\BK{n}{u64}\BK{+w}{ }\BK{n}{\BKZus{}\BKZus{}jiffy\BKZus{}data}\BK{+w}{ }\BK{n}{jiffies\BKZus{}64}\BK{p}{;}
\BK{k}{extern}\BK{+w}{ }\BK{k+kt}{unsigned}\BK{+w}{ }\BK{k+kt}{long}\BK{+w}{ }\BK{k}{volatile}\BK{+w}{ }\BK{n}{\BKZus{}\BKZus{}jiffy\BKZus{}data}\BK{+w}{ }\BK{n}{jiffies}\BK{p}{;}