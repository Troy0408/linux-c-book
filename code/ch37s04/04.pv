\BK{c+cp}{\BKZsh{}}\BK{c+cp}{include}\BK{+w}{ }\BK{c+cpf}{\BKZlt{}stddef.h\BKZgt{}}
\BK{c+cp}{\BKZsh{}}\BK{c+cp}{include}\BK{+w}{ }\BK{c+cpf}{\BKZlt{}sys/socket.h\BKZgt{}}
\BK{c+cp}{\BKZsh{}}\BK{c+cp}{include}\BK{+w}{ }\BK{c+cpf}{\BKZlt{}sys/un.h\BKZgt{}}
\BK{c+cp}{\BKZsh{}}\BK{c+cp}{include}\BK{+w}{ }\BK{c+cpf}{\BKZlt{}errno.h\BKZgt{}}

\BK{c+cp}{\BKZsh{}}\BK{c+cp}{define QLEN 10}

\BK{c+cm}{/*}
\BK{c+cm}{ * Create a server endpoint of a connection.}
\BK{c+cm}{ * Returns fd if all OK, \BKZlt{}0 on error.}
\BK{c+cm}{ */}
\BK{k+kt}{int}\BK{+w}{ }\BK{n+nf}{serv\BKZus{}listen}\BK{p}{(}\BK{k}{const}\BK{+w}{ }\BK{k+kt}{char}\BK{+w}{ }\BK{o}{*}\BK{n}{name}\BK{p}{)}
\BK{p}{\BKZob{}}
\BK{+w}{	}\BK{k+kt}{int}\BK{+w}{                 }\BK{n}{fd}\BK{p}{,}\BK{+w}{ }\BK{n}{len}\BK{p}{,}\BK{+w}{ }\BK{n}{err}\BK{p}{,}\BK{+w}{ }\BK{n}{rval}\BK{p}{;}
\BK{+w}{	}\BK{k}{struct}\BK{+w}{ }\BK{n+nc}{sockaddr\BKZus{}un}\BK{+w}{  }\BK{n}{un}\BK{p}{;}

\BK{+w}{	}\BK{c+cm}{/* create a UNIX domain stream socket */}
\BK{+w}{	}\BK{k}{if}\BK{+w}{ }\BK{p}{(}\BK{p}{(}\BK{n}{fd}\BK{+w}{ }\BK{o}{=}\BK{+w}{ }\BK{n}{socket}\BK{p}{(}\BK{n}{AF\BKZus{}UNIX}\BK{p}{,}\BK{+w}{ }\BK{n}{SOCK\BKZus{}STREAM}\BK{p}{,}\BK{+w}{ }\BK{l+m+mi}{0}\BK{p}{)}\BK{p}{)}\BK{+w}{ }\BK{o}{\BKZlt{}}\BK{+w}{ }\BK{l+m+mi}{0}\BK{p}{)}
\BK{+w}{		}\BK{k}{return}\BK{p}{(}\BK{l+m+mi}{\BKZhy{}1}\BK{p}{)}\BK{p}{;}
\BK{+w}{	}\BK{n}{unlink}\BK{p}{(}\BK{n}{name}\BK{p}{)}\BK{p}{;}\BK{+w}{   }\BK{c+cm}{/* in case it already exists */}

\BK{+w}{	}\BK{c+cm}{/* fill in socket address structure */}
\BK{+w}{	}\BK{n}{memset}\BK{p}{(}\BK{o}{\BKZam{}}\BK{n}{un}\BK{p}{,}\BK{+w}{ }\BK{l+m+mi}{0}\BK{p}{,}\BK{+w}{ }\BK{k}{sizeof}\BK{p}{(}\BK{n}{un}\BK{p}{)}\BK{p}{)}\BK{p}{;}
\BK{+w}{	}\BK{n}{un}\BK{p}{.}\BK{n}{sun\BKZus{}family}\BK{+w}{ }\BK{o}{=}\BK{+w}{ }\BK{n}{AF\BKZus{}UNIX}\BK{p}{;}
\BK{+w}{	}\BK{n}{strcpy}\BK{p}{(}\BK{n}{un}\BK{p}{.}\BK{n}{sun\BKZus{}path}\BK{p}{,}\BK{+w}{ }\BK{n}{name}\BK{p}{)}\BK{p}{;}
\BK{+w}{	}\BK{n}{len}\BK{+w}{ }\BK{o}{=}\BK{+w}{ }\BK{n}{offsetof}\BK{p}{(}\BK{k}{struct}\BK{+w}{ }\BK{n+nc}{sockaddr\BKZus{}un}\BK{p}{,}\BK{+w}{ }\BK{n}{sun\BKZus{}path}\BK{p}{)}\BK{+w}{ }\BK{o}{+}\BK{+w}{ }\BK{n}{strlen}\BK{p}{(}\BK{n}{name}\BK{p}{)}\BK{p}{;}

\BK{+w}{	}\BK{c+cm}{/* bind the name to the descriptor */}
\BK{+w}{	}\BK{k}{if}\BK{+w}{ }\BK{p}{(}\BK{n}{bind}\BK{p}{(}\BK{n}{fd}\BK{p}{,}\BK{+w}{ }\BK{p}{(}\BK{k}{struct}\BK{+w}{ }\BK{n+nc}{sockaddr}\BK{+w}{ }\BK{o}{*}\BK{p}{)}\BK{o}{\BKZam{}}\BK{n}{un}\BK{p}{,}\BK{+w}{ }\BK{n}{len}\BK{p}{)}\BK{+w}{ }\BK{o}{\BKZlt{}}\BK{+w}{ }\BK{l+m+mi}{0}\BK{p}{)}\BK{+w}{ }\BK{p}{\BKZob{}}
\BK{+w}{		}\BK{n}{rval}\BK{+w}{ }\BK{o}{=}\BK{+w}{ }\BK{l+m+mi}{\BKZhy{}2}\BK{p}{;}
\BK{+w}{		}\BK{k}{goto}\BK{+w}{ }\BK{n}{errout}\BK{p}{;}
\BK{+w}{	}\BK{p}{\BKZcb{}}
\BK{+w}{	}\BK{k}{if}\BK{+w}{ }\BK{p}{(}\BK{n}{listen}\BK{p}{(}\BK{n}{fd}\BK{p}{,}\BK{+w}{ }\BK{n}{QLEN}\BK{p}{)}\BK{+w}{ }\BK{o}{\BKZlt{}}\BK{+w}{ }\BK{l+m+mi}{0}\BK{p}{)}\BK{+w}{ }\BK{p}{\BKZob{}}\BK{+w}{ }\BK{c+cm}{/* tell kernel we\BKZsq{}re a server */}
\BK{+w}{		}\BK{n}{rval}\BK{+w}{ }\BK{o}{=}\BK{+w}{ }\BK{l+m+mi}{\BKZhy{}3}\BK{p}{;}
\BK{+w}{		}\BK{k}{goto}\BK{+w}{ }\BK{n}{errout}\BK{p}{;}
\BK{+w}{	}\BK{p}{\BKZcb{}}
\BK{+w}{	}\BK{k}{return}\BK{p}{(}\BK{n}{fd}\BK{p}{)}\BK{p}{;}

\BK{n+nl}{errout}\BK{p}{:}
\BK{+w}{	}\BK{n}{err}\BK{+w}{ }\BK{o}{=}\BK{+w}{ }\BK{n}{errno}\BK{p}{;}
\BK{+w}{	}\BK{n}{close}\BK{p}{(}\BK{n}{fd}\BK{p}{)}\BK{p}{;}
\BK{+w}{	}\BK{n}{errno}\BK{+w}{ }\BK{o}{=}\BK{+w}{ }\BK{n}{err}\BK{p}{;}
\BK{+w}{	}\BK{k}{return}\BK{p}{(}\BK{n}{rval}\BK{p}{)}\BK{p}{;}
\BK{p}{\BKZcb{}}